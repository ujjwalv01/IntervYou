# Database (Neon Postgres pooled connection string)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT
JWT_SECRET=your-secret-key-here-change-in-production

# Vapi
VAPI_PUBLIC_KEY=your-vapi-public-key
VAPI_PRIVATE_KEY=your-vapi-private-key

# Groq
GROQ_API_KEY=your-groq-api-key

# Server
PORT=5001

# Social sign-in (optional — a button only appears once its ID + secret are set)
# Google: console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application)
#   Authorized redirect URI: http://localhost:5001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: github.com/settings/developers → New OAuth App
#   Authorization callback URL: http://localhost:5001/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional
# GROQ_MODEL=openai/gpt-oss-120b          # Groq model for the interview + feedback
# CLIENT_URL=https://your-app.vercel.app  # frontend URL: CORS + where sign-in returns to (default http://localhost:3000)
# API_URL=https://your-api.up.railway.app # this server's public URL, used in OAuth callback URLs (default http://localhost:5001)
